// ============================================
// 1. 数据源和生成器
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
   // url      = env("DATABASE_URL")   // 删除这一行
}

// ============================================
// 2. 枚举定义
// ============================================

enum UserRole {
  USER
  TENANT_ADMIN
  BRANCH_ADMIN
  PLATFORM_ADMIN
}

enum BranchType {
  MEDIATION
  LEGAL
  CHARITY
  COMMUNITY
  COMMUNITY_LIFE
  PROFESSIONAL
  SUPPLY_CHAIN
  CUSTOM
}

enum BranchStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PageStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantType {
  MERCHANT
  ASSOCIATION
  FELLOWSHIP
  ALUMNI
  OTHER
}

enum RatingTargetType {
  POST
  ACTIVITY
  TENANT
  USER
}

// ============================================
// 3. 用户模块
// ============================================

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  phone           String?      @unique
  password        String
  nickname        String?
  avatar          String?
  education        String?
  skills           String?
  hobbies          String?
  bio              String?      @db.Text
  tags             String?
  pets             String?
  role            UserRole     @default(USER)
  verified        Boolean      @default(false)
  canPublishVideo  Boolean      @default(false)
  isSupervisor    Boolean      @default(false)
  points          Int          @default(0)
  reportCount     Int          @default(0)
  blocked         Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // 关系
  tenants              TenantStaff[]
  tenantMembers        TenantMember[]
  pages                Page[]         @relation("PageCreator")
  pageStaff            PageStaff[]
  branchApplications   BranchApplication[]
  approvedBranchApplications BranchApplication[] @relation("BranchApprover")
  branchStaff          BranchStaff[]
  activities           Activity[]
  ratings              Rating[]
  posts                Post[]
  following            Follow[]     @relation("Follower")
  followers            Follow[]     @relation("Followee")
  sentReports          Report[]     @relation("Reporter")
  handledReports     Report[]     @relation("ReportHandler")
  auditLogs            AuditLog[]   @relation("Auditor")
  notifications        Notification[]
  organizationMembers OrganizationMember[]
  activitySignups      ActivitySignup[]
}

// ============================================
// 4. 租户模块
// ============================================

model Tenant {
  id              String       @id @default(cuid())
  name            String
  logo            String?
  description     String?
  category        String
  communityCode   String
  adCode          String
  address         String?
  phone           String?
  email           String?
  website         String?
  verified        Boolean      @default(false)
  status          String       @default("PENDING")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  staff           TenantStaff[]
  activities      Activity[]
  posts           Post[]
  members         TenantMember[]
  roles               OrganizationRole[]
  organizationMembers  OrganizationMember[]
}

model TenantStaff {
  id              String       @id @default(cuid())
  tenantId        String
  userId          String
  role            String       @default("PUBLISHER")
  createdAt       DateTime     @default(now())

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
}

model TenantMember {
  id              String       @id @default(cuid())
  tenantId        String
  userId          String
  status          String       @default("ACTIVE")
  joinedAt        DateTime     @default(now())
  leftAt          DateTime?

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
}

// ============================================

// ============================================
// 5. 组织职位与成员
// ============================================

model OrganizationRole {
  id              String   @id @default(cuid())
  tenantId        String?
  branchId        String?
  pageId          String?
  name            String
  level           Int      @default(0)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  members OrganizationMember[]
}

model OrganizationMember {
  id              String   @id @default(cuid())
  tenantId        String?
  branchId        String?
  pageId          String?
  userId          String
  roleId          String
  joinedAt        DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  role   OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

// 5. 主页模块
// ============================================

model Page {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  orgType         String
  certType        String?
  category        String
  communityCode   String
  phone           String?
  email           String?
  description     String?      @db.Text
  certNumber      String?
  parentOrg       String?
  declaration     String?      @db.Text
  status          PageStatus   @default(PENDING)
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  creator         User         @relation("PageCreator", fields: [createdById], references: [id])
  staff           PageStaff[]
  posts           Post[]
  roles               OrganizationRole[]
  organizationMembers  OrganizationMember[]
}

model PageStaff {
  id              String       @id @default(cuid())
  pageId          String
  userId          String
  role            String       @default("OWNER")
  createdAt       DateTime     @default(now())

  page            Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([pageId, userId])
}

// ============================================
// 6. 分会模块
// ============================================

model BranchApplication {
  id              String       @id @default(cuid())
  userId          String
  branchType      BranchType
  name            String
  description     String?
  communityCode   String
  category        String?
  termStart       DateTime
  termEnd         DateTime
  status          BranchStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  feedback        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id])
  approvedUser    User?        @relation("BranchApprover", fields: [approvedBy], references: [id])
}

model Branch {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  branchType      BranchType
  communityCode   String
  category        String?
  description     String?
  isExclusive      Boolean      @default(false)
  scope            String?
  canAllResidentsJoin Boolean @default(false)
  councillorWeighted Boolean @default(false)
  termStart       DateTime
  termEnd         DateTime
  status          String       @default("PENDING")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  staff           BranchStaff[]
  posts           Post[]
  roles               OrganizationRole[]
  organizationMembers  OrganizationMember[]
}

model BranchStaff {
  id              String       @id @default(cuid())
  branchId        String
  userId          String
  role            String       @default("PRESIDENT")
  createdAt       DateTime     @default(now())

  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([branchId, userId])
}

// ============================================
// 6. 活动模块
// ============================================

model Activity {
  id              String       @id @default(cuid())
  title           String
  description     String?
  isExclusive      Boolean      @default(false)
  scope            String?
  canAllResidentsJoin Boolean @default(false)
  councillorWeighted Boolean @default(false)
  location        String
  communityCode   String
  startTime       DateTime
  endTime         DateTime
  maxParticipants Int?
  currentCount    Int          @default(0)
  status          String       @default("DRAFT")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenantId        String?
  userId          String

  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user            User         @relation(fields: [userId], references: [id])

  signups         ActivitySignup[]
}

model ActivitySignup {
  id              String       @id @default(cuid())
  activityId      String
  userId          String?
  name            String
  phone           String
  status          String       @default("REGISTERED")
  signupCode      String       @unique
  createdAt       DateTime     @default(now())

  activity        Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id])
}

// ============================================
// 7. 资讯模块
// ============================================

model Post {
  id              String       @id @default(cuid())
  title           String?
  content         String?
  category        String?
  communityCode   String?
  images          String?
  videoUrl        String?
  videoDuration   Int?
  status          String       @default("PUBLISHED")
  viewCount       Int          @default(0)
  likeCount       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  userId          String
  tenantId        String?
  pageId          String?
  branchId        String?

  user            User         @relation(fields: [userId], references: [id])
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  page            Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

// ============================================
// 8. 评价模块
// ============================================

model Rating {
  id              String       @id @default(cuid())
  score           Int          @default(5)
  targetId        String
  targetType      RatingTargetType
  userId          String
  comment         String?      @db.Text
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id])

  @@unique([userId, targetId, targetType])
  @@index([targetId, targetType])
  @@index([targetType])
}

// ============================================
// 9. 关注模块
// ============================================

model Follow {
  id              String       @id @default(cuid())
  followerId      String
  followeeId      String
  followeeType    String
  createdAt       DateTime     @default(now())

  follower        User         @relation("Follower", fields: [followerId], references: [id])
  followeeUser    User?        @relation("Followee", fields: [followeeId], references: [id])

  @@unique([followerId, followeeId, followeeType])
}

// ============================================
// 10. 举报与审计模块
// ============================================

model Report {
  id                String       @id @default(cuid())
  reporterId        String
  targetId          String
  targetType        String
  reason            String
  status            String       @default("PENDING")
  resolution        String?
  handlerId         String?
  handlerRole       String?
  communityBranchId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  reporter User  @relation("Reporter", fields: [reporterId], references: [id])
  handler  User? @relation("ReportHandler", fields: [handlerId], references: [id])
}

model Notification {
  id              String       @id @default(cuid())
  userId          String
  title           String
  content         String?
  type            String       @default("SYSTEM")
  isRead          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              String       @id @default(cuid())
  adminId         String
  action          String
  targetType      String
  targetId        String
  details         String?      @db.Text
  createdAt       DateTime     @default(now())

  admin           User         @relation("Auditor", fields: [adminId], references: [id])
}

// ============================================
// 11. 静态数据表
// ============================================

model Community {
  code            String       @id
  name            String
  districtCode    String
  districtName    String
  regionCode      String
  regionName      String
  createdAt       DateTime     @default(now())
}

model Category {
  code            String       @id
  name            String
  parentCode      String?
  level           Int          @default(1)
  createdAt       DateTime     @default(now())
}

model BranchTypeConfig {
  id              String       @id @default(cuid())
  type            BranchType   @unique
  label           String
  description     String?
  isExclusive      Boolean      @default(false)
  scope            String?
  canAllResidentsJoin Boolean @default(false)
  councillorWeighted Boolean @default(false)
  enabled         Boolean      @default(true)
  requireCategory  Boolean     @default(false)
  requireCommunity Boolean     @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
