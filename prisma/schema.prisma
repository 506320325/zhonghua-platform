// ============================================
// 1. 数据源和生成器
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
   // url      = env("DATABASE_URL")   // 删除这一行
}

// ============================================
// 2. 枚举定义
// ============================================

enum UserRole {
  USER
  TENANT_ADMIN
  BRANCH_ADMIN
  PLATFORM_ADMIN
}

enum BranchType {
  MEDIATION
  LEGAL
  CHARITY
  COMMUNITY
  COMMUNITY_LIFE
  PROFESSIONAL
  SUPPLY_CHAIN
  CUSTOM
}

enum BranchStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PageStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantType {
  MERCHANT
  ASSOCIATION
  FELLOWSHIP
  ALUMNI
  OTHER
}

enum RatingTargetType {
  POST
  ACTIVITY
  TENANT
  USER
}

// ============================================
// 3. 用户模块
// ============================================

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  phone           String?      @unique
  password        String
  nickname        String?
  avatar          String?
  education        String?
  skills           String?
  hobbies          String?
  bio              String?      @db.Text
  tags             String?
  pets             String?
  role            UserRole     @default(USER)
  verified        Boolean      @default(false)
  canPublishVideo  Boolean      @default(false)
  isSupervisor    Boolean      @default(false)
  points          Int          @default(0)
  reportCount     Int          @default(0)
  blocked         Boolean      @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // 关系
  tenants              TenantStaff[]
  tenantMembers        TenantMember[]
  pages                Page[]         @relation("PageCreator")
  pageStaff            PageStaff[]
  branchApplications   BranchApplication[]
  approvedBranchApplications BranchApplication[] @relation("BranchApprover")
  branchStaff          BranchStaff[]
  activities           Activity[]
  ratings              Rating[]
  posts                Post[]
  following            Follow[]     @relation("Follower")
  followers            Follow[]     @relation("Followee")
  sentReports          Report[]     @relation("Reporter")
  handledReports     Report[]     @relation("ReportHandler")
  stampsSent          Stamp[]      @relation("StampFrom")
  stampsReceived      Stamp[]      @relation("StampTo")
  dailyStamps         DailyStamp[]
  eventPages        EventPage[]
  eventComments     EventComment[]
  announcements     Announcement[]
  sentMessages      Message[]
  auditLogs            AuditLog[]   @relation("Auditor")
  notifications        Notification[]
  organizationMembers OrganizationMember[]
  activitySignups      ActivitySignup[]
}

// ============================================
// 4. 租户模块
// ============================================

model Tenant {
  id              String       @id @default(cuid())
  name            String
  logo            String?
  description     String?
  category        String
  communityCode   String
  adCode          String
  address         String?
  phone           String?
  email           String?
  website         String?
  verified        Boolean      @default(false)
  status          String       @default("PENDING")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  staff           TenantStaff[]
  activities      Activity[]
  posts           Post[]
  members         TenantMember[]
  stampsReceived      Stamp[]
  roles               OrganizationRole[]
  organizationMembers  OrganizationMember[]
  announcements      Announcement[]
}

model TenantStaff {
  id              String       @id @default(cuid())
  tenantId        String
  userId          String
  role            String       @default("PUBLISHER")
  createdAt       DateTime     @default(now())

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
}

model TenantMember {
  id              String       @id @default(cuid())
  tenantId        String
  userId          String
  status          String       @default("ACTIVE")
  joinedAt        DateTime     @default(now())
  leftAt          DateTime?

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
}

// ============================================

// ============================================
// 5. 组织职位与成员
// ============================================

model OrganizationRole {
  id              String   @id @default(cuid())
  tenantId        String?
  branchId        String?
  pageId          String?
  name            String
  level           Int      @default(0)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  members OrganizationMember[]
}

model OrganizationMember {
  id              String   @id @default(cuid())
  tenantId        String?
  branchId        String?
  pageId          String?
  userId          String
  roleId          String
  joinedAt        DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  role   OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

// 5. 主页模块
// ============================================

model Page {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  orgType         String
  certType        String?
  category        String
  communityCode   String
  phone           String?
  email           String?
  description     String?      @db.Text
  joinRequiresApproval Boolean  @default(false)
  joinRequiresReferrer Boolean @default(false)
  certNumber      String?
  parentOrg       String?
  declaration     String?      @db.Text
  status          PageStatus   @default(PENDING)
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  creator         User         @relation("PageCreator", fields: [createdById], references: [id])
  staff           PageStaff[]
  posts           Post[]
  roles               OrganizationRole[]
  organizationMembers  OrganizationMember[]
}

model PageStaff {
  id              String       @id @default(cuid())
  pageId          String
  userId          String
  role            String       @default("OWNER")
  createdAt       DateTime     @default(now())

  page            Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([pageId, userId])
}

// ============================================
// 6. 分会模块
// ============================================

model BranchApplication {
  id              String       @id @default(cuid())
  userId          String
  branchType      BranchType
  name            String
  description     String?
  communityCode   String
  category        String?
  termStart       DateTime
  termEnd         DateTime
  status          BranchStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  feedback        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id])
  approvedUser    User?        @relation("BranchApprover", fields: [approvedBy], references: [id])
}

model Branch {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  branchType      BranchType
  communityCode   String
  category        String?
  description     String?
  joinRequiresApproval Boolean  @default(false)
  joinRequiresReferrer Boolean @default(false)
  isExclusive      Boolean      @default(false)
  scope            String?
  canAllResidentsJoin Boolean @default(false)
  councillorWeighted Boolean @default(false)
  termStart       DateTime
  termEnd         DateTime
  status          String       @default("PENDING")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  staff           BranchStaff[]
  posts           Post[]
  roles               OrganizationRole[]
  organizationMembers  OrganizationMember[]
  announcements      Announcement[]
  stampsReceived      Stamp[]
}

model BranchStaff {
  id              String       @id @default(cuid())
  branchId        String
  userId          String
  role            String       @default("PRESIDENT")
  status          String       @default("ACTIVE")
  referrerId      String?
  referrerEmail   String?
  createdAt       DateTime     @default(now())

  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([branchId, userId])
}

// ============================================
// 6. 活动模块
// ============================================

model Activity {
  id              String       @id @default(cuid())
  title           String
  description     String?
  joinRequiresApproval Boolean  @default(false)
  joinRequiresReferrer Boolean @default(false)
  isExclusive      Boolean      @default(false)
  scope            String?
  canAllResidentsJoin Boolean @default(false)
  councillorWeighted Boolean @default(false)
  location        String
  communityCode   String
  startTime       DateTime
  endTime         DateTime
  maxParticipants Int?
  currentCount    Int          @default(0)
  status          String       @default("DRAFT")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenantId        String?
  userId          String

  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user            User         @relation(fields: [userId], references: [id])

  signups         ActivitySignup[]
}

model ActivitySignup {
  id              String       @id @default(cuid())
  activityId      String
  userId          String?
  name            String
  phone           String
  status          String       @default("REGISTERED")
  signupCode      String       @unique
  createdAt       DateTime     @default(now())

  activity        Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id])
}

// ============================================
// 7. 资讯模块
// ============================================


// ============================================
// 6.5 預約
// ============================================


model Service {
  id              String   @id @default(cuid())
  name            String
  category        String
  description     String?  @db.Text
  price           Int?
  duration        Int?
  tenantId        String
  confirmType     String   @default("MANUAL")
  status          String   @default("PUBLISHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserNoShowRecord {
  id              String   @id @default(cuid())
  userId          String
  bookingId       String
  noShowAt        DateTime @default(now())
  createdAt       DateTime @default(now())
}


// ============================================
// 需求
// ============================================

model Demand {
  id              String   @id @default(cuid())
  type            String
  title           String
  content         String   @db.Text
  budgetMin       Int?
  budgetMax       Int?
  location        String?
  images          String?
  recommendTarget String?
  status          String   @default("PUBLISHED")
  userId          String
  tenantId        String?
  branchId        String?
  responses       String?
  rating          Int?
  comment         String?  @db.Text
  surveyId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// 問卷
// ============================================

model Survey {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  questions       Json
  deadline        DateTime?
  isAnonymous     Boolean  @default(true)
  status          String   @default("DRAFT")
  visibilityScope String   @default("PUBLIC")
  regionLimit     String?
  ageMin          Int?
  ageMax          Int?
  genderLimit     String   @default("不限")
  userId          String
  tenantId        String?
  branchId        String?
  demandId        String?
  responseCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SurveyResponse {
  id              String   @id @default(cuid())
  surveyId        String
  userId          String?
  answers         Json
  createdAt       DateTime @default(now())
}

model SurveyStats {
  id              String   @id @default(cuid())
  surveyId        String   @unique
  questionStats   Json
  updatedAt       DateTime @updatedAt
}

model Booking {
  id              String   @id @default(cuid())
  tenantId        String?
  branchId        String?
  serviceName     String
  serviceId         String?
  endTime           DateTime?
  name              String?
  phone             String?
  remark            String?
  isWaitlist        Boolean  @default(false)
  waitlistPosition  Int?
  rating            Int?
  comment           String?  @db.Text
  userId          String
  userName        String
  userPhone       String
  bookingTime     DateTime
  duration        Int?
  status          String   @default("PENDING")
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  isNoShow        Boolean  @default(false)
  noShowAt        DateTime?
  waitlist        String?
  waitlistCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Post {
  id              String       @id @default(cuid())
  title           String?
  content         String?
  category        String?
  communityCode   String?
  images          String?
  videoUrl        String?
  videoDuration   Int?
  type              String       @default("DAILY")
  inviteCategory    String?
  maxParticipants   Int?
  currentCount      Int          @default(0)
  genderLimit       String       @default("不限")
  ageMin            Int?
  ageMax            Int?
  deadline          DateTime?
  participants      String?
  location          String?
  isPinned          Boolean      @default(false)
  isHidden          Boolean      @default(false)
  commentCount      Int          @default(0)
  complaintCount    Int          @default(0)
  visibilityScope   String       @default("PUBLIC")
  joinScope         String       @default("SAME")
  allowedUserIds    String?
  regionLimit       String?
  status          String       @default("PUBLISHED")
  viewCount       Int          @default(0)
  likeCount       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  userId          String
  tenantId        String?
  pageId          String?
  branchId        String?

  user            User         @relation(fields: [userId], references: [id])
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  page            Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

// ============================================

// ============================================

// ============================================
// 7.4 活動主頁（臨時組合）
// ============================================

model EventPage {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String?  @db.Text
  coverImage      String?
  eventDate       DateTime
  endDate         DateTime?
  location        String?
  status          String   @default("DRAFT")
  organizers      Json
  coOrganizers    Json
  supportingOrgs  Json
  participantOrgs Json
  guests          Json
  commentEnabled  Boolean  @default(true)
  ratingEnabled   Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdByUser User          @relation(fields: [createdBy], references: [id])
  comments      EventComment[]
}

model EventComment {
  id              String   @id @default(cuid())
  eventPageId     String
  userId          String
  content         String
  isHidden        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  eventPage EventPage @relation(fields: [eventPageId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

// 7.5 信贴
// ============================================

model Stamp {
  id              String   @id @default(cuid())
  fromUserId      String
  toUserId        String?
  toTenantId      String?
  toBranchId      String?
  pattern         String
  color           String
  message         String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  fromUser  User    @relation("StampFrom", fields: [fromUserId], references: [id])
  toUser    User?   @relation("StampTo", fields: [toUserId], references: [id])
  toTenant  Tenant? @relation(fields: [toTenantId], references: [id])
  toBranch  Branch? @relation(fields: [toBranchId], references: [id])

  @@index([toUserId])
  @@index([toTenantId])
  @@index([toBranchId])
  @@index([createdAt])
}

model DailyStamp {
  id              String   @id @default(cuid())
  userId          String
  date            String
  remaining       Int      @default(3)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

// 8. 评价模块
// ============================================


// ============================================
// 8. 公告
// ============================================

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  scope     String   @default("PLATFORM")
  tenantId  String?
  branchId  String?
  startAt   DateTime @default(now())
  endAt     DateTime?
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser User     @relation(fields: [createdBy], references: [id])
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
}


// ============================================
// 9. 在線會話
// ============================================

model Conversation {
  id              String   @id @default(cuid())
  participants    Json
  type            String   @default("USER_TO_PLATFORM")
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages Message[]
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  content         String   @db.Text
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User        @relation(fields: [senderId], references: [id])
}


// ============================================
// 10. 用戶偏好與標記
// ============================================

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  noAd            Boolean  @default(false)
  noEventNotify   Boolean  @default(false)
  noAllNotify     Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model UserTag {
  id              String   @id @default(cuid())
  tenantId        String?
  branchId        String?
  userId          String
  tag             String
  note            String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Rating {
  id              String       @id @default(cuid())
  score           Int          @default(5)
  targetId        String
  targetType      RatingTargetType
  userId          String
  comment         String?      @db.Text
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id])

  @@unique([userId, targetId, targetType])
  @@index([targetId, targetType])
  @@index([targetType])
}

// ============================================
// 9. 关注模块
// ============================================

model Follow {
  id              String       @id @default(cuid())
  followerId      String
  followeeId      String
  followeeType    String
  createdAt       DateTime     @default(now())

  follower        User         @relation("Follower", fields: [followerId], references: [id])
  followeeUser    User?        @relation("Followee", fields: [followeeId], references: [id])

  @@unique([followerId, followeeId, followeeType])
}

// ============================================
// 10. 举报与审计模块
// ============================================

model Report {
  id                String       @id @default(cuid())
  reporterId        String
  targetId          String
  targetType        String
  reason            String
  status            String       @default("PENDING")
  resolution        String?
  handlerId         String?
  handlerRole       String?
  communityBranchId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  reporter User  @relation("Reporter", fields: [reporterId], references: [id])
  handler  User? @relation("ReportHandler", fields: [handlerId], references: [id])
}

model Notification {
  id              String       @id @default(cuid())
  userId          String
  title           String
  content         String?
  type            String       @default("SYSTEM")
  isRead          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              String       @id @default(cuid())
  adminId         String
  action          String
  targetType      String
  targetId        String
  details         String?      @db.Text
  createdAt       DateTime     @default(now())

  admin           User         @relation("Auditor", fields: [adminId], references: [id])
}

// ============================================
// 11. 静态数据表
// ============================================

model Community {
  code            String       @id
  name            String
  districtCode    String
  districtName    String
  regionCode      String
  regionName      String
  createdAt       DateTime     @default(now())
}

model Category {
  code            String       @id
  name            String
  parentCode      String?
  level           Int          @default(1)
  createdAt       DateTime     @default(now())
}

model BranchTypeConfig {
  id              String       @id @default(cuid())
  type            BranchType   @unique
  label           String
  description     String?
  joinRequiresApproval Boolean  @default(false)
  joinRequiresReferrer Boolean @default(false)
  isExclusive      Boolean      @default(false)
  scope            String?
  canAllResidentsJoin Boolean @default(false)
  councillorWeighted Boolean @default(false)
  enabled         Boolean      @default(true)
  requireCategory  Boolean     @default(false)
  requireCommunity Boolean     @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
